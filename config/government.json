// Rules of the game. Fixed during a run; only the player changes them, before it starts.
{
  "horizonYears": 40,
  "taxBounds": {
    "income":      { "min": 0.05, "max": 0.60 },
    "corporate":   { "min": 0.05, "max": 0.45 },
    "consumption": { "min": 0.05, "max": 0.30 }
  },
  "maxTaxChangePerYear": 0.03,
  "deficitBounds": { "min": -0.05, "max": 0.08 },
  "reallocationAllowance": 0.05,
  // Management share: the part of each sector's money spent on running it.
  "managementShareBounds": { "min": 0.0, "max": 0.25 },
  "maxManagementChangePerYear": 0.02,
  "floors": {
    "debt":              { "enabled": true, "maxInterestShareOfRevenue": 0.20, "rateCeiling": 0.12 },
    // EU fiscal rules, simplified: deficit under 3%, and debt above 60% falling on average over 4 years
    // (1 point a year above 90%, half a point between 60% and 90%). Crisis years fall under the escape clause.
    "fiscalRules":       { "enabled": true, "deficitLimit": 0.03, "debtReference": 0.60, "highDebt": 0.90,
                           "requiredDeclineHigh": 0.01, "requiredDeclineMid": 0.005, "windowYears": 4 },
    "incomeGroups":     { "enabled": true, "minShareOfStart": 0.80 },
    "endStateStocks":    { "enabled": true, "threshold": 0.98 },
    "endStatePipelines": { "enabled": true, "share": 0.95 },
    // A constitutional right to education: every fifth's basic completion stays at or above the threshold.
    "rightToEducation":  { "enabled": true, "minBasicCoverage": 0.90 }
  },
  // The constitution: set by the player before a run, never changed by a government.
  "constitution": { "compulsoryAge": 18 },
  // Resistance to policies (strikes), identical for every government. Off by default.
  "resistance": { "enabled": false, "cutThreshold": 0.05, "lossPerCut": 0.5, "regimeChangeLoss": 0.002 },
  "scoreTolerance": 0.001
}
