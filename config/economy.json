// Economy parameters. Every value is an assumption for the toy, not calibrated.
{
  "capitalShare": 0.35,
  "trendProductivityGrowth": 0.01,
  "fiscalMultiplier": 0.5,
  "externalExposure": 0.35,
  "stocks": {
    // Workforce skills: output exponent; school leavers join the workforce after delayYears; a share retires each year.
    "skills":           { "exponent": 0.30, "delayYears": 9,  "depreciation": 0.025 },
    // The school system, built by effective education spending.
    "schools":          { "delayYears": 3, "depreciation": 0.10 },
    "health":           { "exponent": 0.15, "delayYears": 3,  "depreciation": 0.05 },
    "infrastructure":   { "exponent": 0.10, "delayYears": 5,  "depreciation": 0.04 },
    "farmProductivity": { "exponent": 0.30, "delayYears": 2,  "depreciation": 0.05 },
    "stateCapacity":    { "delayYears": 3, "depreciation": 0.08 },
    "stability":        { "delayYears": 0, "depreciation": 0.20 },
    "privateCapital":   { "delayYears": 0, "depreciation": 0.06 }
  },
  // The sector template (all assumptions). Effective spending = front-line money x efficiency, where
  // efficiency = min(maxEfficiency, management index ^ exponent). With exponent 0.15 the best management
  // share is about 13% of a line. Front-line money can grow absorptionGrowth x efficiency a year over what
  // the sector absorbed last year; the excess builds only excessEffectiveness as much.
  "management": {
    "startShare": 0.05,
    "exponent": 0.15,
    "maxEfficiency": 1.5,
    "delayYears": 2,
    "depreciation": 0.10,
    "absorptionGrowth": 0.10,
    "excessEffectiveness": 0.2
  },
  // Education (all assumptions). Skill of a school leaver = quality x (value of levels completed).
  // Quality = (school stock per pupil) ^ spendingElasticity: doubling spending per pupil raises learning about 40%.
  // Coverage odds rise with quality and with the parents' schooling (the fifth's workforce skills against its start).
  "education": {
    "levelSkill": { "basic": 1.0, "secondary": 0.35, "higher": 0.45 },
    "levelYears": { "basic": 9, "secondary": 3, "higher": 4 },
    "spendingElasticity": 0.5,
    "qualityElasticity": 0.5,
    "parentElasticity": 1.0,
    "coverageSpeed": 0.25,
    "wageElasticity": 1.0
  },
  "loss":       { "base": 0.01, "stabilityExponent": 0.5, "max": 0.5 },
  "leakage":    { "base": 0.05, "capacityExponent": 1.0, "max": 0.5 },
  "collection": { "base": 0.90, "capacityExponent": 0.5 },
  "taxElasticity": { "income": 0.30, "corporate": 0.60, "consumption": 0.20 },
  "investmentShareOfProfit": 0.60,
  "priceWeights": { "energy": 0.08, "food": 0.15 },
  "inflation": 0.02,
  // Borrowing rate = world rate + constant + rating spread + stress coefficient x financial stress.
  "borrowing": {
    "spreadConstant": 0.002,
    "stressCoefficient": 0.02,
    "averageMaturityYears": 7
  },
  // One composite rating agency. The constant is set so Portugal today scores about A-.
  // Rough check: debt 110%, deficit 7%, debt rising 10 points a year, growth -1.7% (Portugal 2011) scores about BB.
  "rating": {
    "scale": ["AAA", "AA+", "AA", "AA-", "A+", "A", "A-", "BBB+", "BBB", "BBB-", "BB+", "BB", "BB-", "B+", "B", "B-", "CCC"],
    "junkFrom": 10,
    "constant": -0.2,
    "debtWeight": 7.0,
    "deficitWeight": 0.25,
    "trendWeight": 0.2,
    "growthWeight": 0.3,
    "growthReference": 0.015,
    "outlookGap": 0.5,
    "crisisGap": 2.5,
    "spreadPerNotch": 0.0015,
    "junkCliff": 0.02,
    "junkSpreadPerNotch": 0.006
  }
}
