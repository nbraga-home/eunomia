// Named assumption sets. The multiplier scales the returns on skills, health, infrastructure, farm productivity
// and management. educationSpendingElasticity is how strongly school stock per pupil turns into learning:
// doubling spending per pupil raises learning by about 23% (0.3), 41% (0.5) or 74% (0.8).
{
  "central":     { "returnsMultiplier": 1.0, "educationSpendingElasticity": 0.5 },
  "lowReturns":  { "returnsMultiplier": 0.5, "educationSpendingElasticity": 0.3 },
  "highReturns": { "returnsMultiplier": 1.5, "educationSpendingElasticity": 0.8 }
}
